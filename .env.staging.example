# Copy to .env.staging on the server, then replace every CHANGE_ME:
#   cp .env.staging.example .env.staging
#   sed -i "s|CHANGE_ME_JWT_SECRET|$(openssl rand -base64 64 | tr -d '\n')|" .env.staging
#   sed -i "s|CHANGE_ME_DB_PASSWORD|YourStrongPassword|g" .env.staging   # no '$' in the password
# Rules: no spaces around '=', no quotes, every value on ONE line, LF line endings.

# Which env file the containers load (must match the --env-file you pass)
ENV_FILE=.env.staging

# ---- Public address ----
# No domain bought? Use sslip.io with your Elastic IP, e.g. 13.250.10.20 -> hrm.13-250-10-20.sslip.io
DOMAIN=hrm.47-131-131-103.sslip.io

# ---- Database ----
DB_HOST=postgres
DB_PORT=5432
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

USER_DB_NAME=hrm_db_user
HR_DB_NAME=hrm_db_hr
EMPLOYEE_DB_NAME=hrm_db_employee
ADMIN_DB_NAME=hrm_db_admin

USER_DB_USERNAME=postgres
HR_DB_USERNAME=postgres
EMPLOYEE_DB_USERNAME=postgres
ADMIN_DB_USERNAME=postgres

USER_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
HR_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
EMPLOYEE_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
ADMIN_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---- Security ----
# Generate with: openssl rand -base64 64 | tr -d '\n'   (must be ONE line)
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Must exactly match the address in the browser: https://<DOMAIN>
CORS_ALLOWED_ORIGINS=https://hrm.47-131-131-103.sslip.io

# ---- Service-to-service URLs (Docker service names) ----
USER_SERVICE_URL=http://user-service:5004
HR_SERVICE_URL=http://hr-service:5005
EMPLOYEE_SERVICE_URL=http://employee-service:5006

# ---- Email (Employee service; Gmail needs an App Password) ----
MAIL_USERNAME=
MAIL_PASSWORD=

LOG_LEVEL=INFO
