# ========================================
# HRM Backend — Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ========================================

# ─── PostgreSQL Database ───────────────
DB_HOST=localhost
DB_PORT=5432

# Employee Service Database
EMPLOYEE_DB_NAME=hrm_db_admin
EMPLOYEE_DB_USERNAME=postgres
EMPLOYEE_DB_PASSWORD=newpassword123

# HR Service Database
HR_DB_NAME=hrm_db_hr
HR_DB_USERNAME=postgres
HR_DB_PASSWORD=newpassword123

# User Service Database (Legacy)
USER_DB_NAME=hrm_db_user
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=newpassword123

# Admin Service Database (shares Employee DB so admin can see all data)
ADMIN_DB_NAME=hrm_db_employee
ADMIN_DB_USERNAME=postgres
ADMIN_DB_PASSWORD=newpassword123

# ─── JWT Configuration ────────────────
# IMPORTANT: Use a strong secret (min 256 bits / 32+ chars)
# Generate one: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRATION=86400000

# ─── Server Ports ─────────────────────
ADMIN_SERVICE_PORT=5007
EMPLOYEE_SERVICE_PORT=5006
HR_SERVICE_PORT=5005
USER_SERVICE_PORT=5004

# ─── CORS ─────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ─── SMTP Email Configuration (Gmail) ─
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password

# ─── Logging ──────────────────────────
LOG_LEVEL=INFO
